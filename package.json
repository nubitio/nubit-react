{
  "name": "nubit-react",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.30.2",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsdown && node scripts/bundle-nubit-css.mjs && pnpm build:themes",
    "build:themes": "sass packages/ui/theme/styles/theme-dark.scss packages/ui/dist/themes/nb-theme-dark.css --no-source-map && sass packages/ui/theme/styles/theme-light.scss packages/ui/dist/themes/nb-theme-light.css --no-source-map",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "lint": "eslint packages examples --max-warnings 0",
    "lint:strict": "eslint packages examples --max-warnings 0",
    "format": "prettier --write \"**/*.{ts,tsx,json,scss,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,scss,md}\"",
    "check": "pnpm lint:strict && pnpm typecheck && pnpm validate:boundaries && pnpm test:coverage && pnpm build && pnpm validate:packages && pnpm example:build",
    "validate:packages": "node scripts/validate-packages.mjs",
    "validate:boundaries": "node scripts/check-package-boundaries.mjs",
    "version:set": "node scripts/set-version.mjs",
    "example:build": "pnpm --filter admin-demo build",
    "example:dev": "pnpm --filter admin-demo dev",
    "example:e2e": "pnpm --filter admin-demo test:e2e",
    "eject": "node packages/eject/bin/nubit.mjs"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^9.39.5",
    "@tanstack/react-query": "^5.104.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@tiptap/extension-link": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "@tsdown/css": "^0.22.14",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "happy-dom": "^20.14.5",
    "i18next": "^23.16.8",
    "prettier": "^3.9.9",
    "publint": "^0.3.24",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-dropzone": "^15.0.0",
    "react-i18next": "^14.1.3",
    "react-router-dom": "^6.30.6",
    "sass": "^1.105.1",
    "tsdown": "^0.22.14",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^4.1.11"
  }
}
