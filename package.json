{
  "name": "nubit-react",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.30.2",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsdown && node scripts/bundle-nubit-css.mjs && pnpm build:themes",
    "build:themes": "sass packages/ui/theme/styles/theme-dark.scss packages/ui/dist/themes/nb-theme-dark.css --no-source-map && sass packages/ui/theme/styles/theme-light.scss packages/ui/dist/themes/nb-theme-light.css --no-source-map",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "lint": "eslint packages examples --max-warnings 0",
    "lint:strict": "eslint packages examples --max-warnings 0",
    "format": "prettier --write \"**/*.{ts,tsx,json,scss,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,scss,md}\"",
    "check": "pnpm lint:strict && pnpm typecheck && pnpm validate:boundaries && pnpm test:coverage && pnpm build && pnpm validate:packages && pnpm example:build",
    "validate:packages": "node scripts/validate-packages.mjs",
    "validate:boundaries": "node scripts/check-package-boundaries.mjs",
    "version:set": "node scripts/set-version.mjs",
    "example:build": "pnpm --filter admin-demo build",
    "example:dev": "pnpm --filter admin-demo dev",
    "example:e2e": "pnpm --filter admin-demo test:e2e",
    "eject": "node packages/eject/bin/nubit.mjs"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^9.39.5",
    "@tanstack/react-query": "^5.108.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@tiptap/extension-link": "^3.34.0",
    "@tiptap/react": "^3.34.0",
    "@tiptap/starter-kit": "^3.34.0",
    "@tsdown/css": "^0.23.7",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.1.1",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "happy-dom": "^21.0.4",
    "i18next": "^27.2.7",
    "prettier": "^3.10.1",
    "publint": "^0.3.25",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-dropzone": "^20.2.1",
    "react-i18next": "^18.0.3",
    "react-router-dom": "^7.18.6",
    "sass": "^1.108.2",
    "tsdown": "^0.23.7",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  },
  "pnpm": {
    "overrides": {
      "react": "19.3.1",
      "react-dom": "19.3.1",
      "typescript": "^6.0.3"
    },
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-mrhx-c7xc-m3w5"
      ]
    }
  }
}
